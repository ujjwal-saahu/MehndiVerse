# Staging environment — see docs/environments.md#staging. Real values live
# only in the GitHub Environment "staging"'s encrypted secrets
# (Settings -> Environments -> staging), never in this file or in CI logs.
# This documents the *shape* only.

ENVIRONMENT=staging
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Managed Postgres/Redis instances dedicated to staging — never the same
# instance production uses, so a staging bug or load test can't affect
# real user data.
DATABASE_URL=__SECRET__
REDIS_URL=__SECRET__

CORS_ORIGINS=["https://staging.mehndiverse.example","https://staging-admin.mehndiverse.example"]

# A separate Supabase *project* from production (not just different keys
# against the same project) — staging test accounts/sign-ups must never
# land in the production user table.
SUPABASE_URL=__SECRET__
SUPABASE_ANON_KEY=__SECRET__
SUPABASE_SERVICE_ROLE_KEY=__SECRET__
SUPABASE_JWT_SECRET=__SECRET__
SUPABASE_JWT_AUDIENCE=authenticated

# Razorpay *test-mode* keys (rzp_test_...) — staging never touches real
# money, even though it's otherwise a production-like environment.
RAZORPAY_KEY_ID=__SECRET__
RAZORPAY_KEY_SECRET=__SECRET__
RAZORPAY_WEBHOOK_SECRET=__SECRET__

AI_PROVIDER=local
AI_PROVIDER_API_KEY=__SECRET__

# Observability — see docs/observability.md.
METRICS_TOKEN=__SECRET__
SENTRY_DSN=__SECRET__
SENTRY_TRACES_SAMPLE_RATE=0.1
ALERT_WEBHOOK_URL=__SECRET__
