# Production environment — see docs/environments.md#production. Real
# values live only in the GitHub Environment "production"'s encrypted
# secrets (Settings -> Environments -> production), gated by required
# reviewers (see docs/deployment.md#production-approval-gate). This
# documents the *shape* only — never fill this file in with real values.

ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=__SECRET__
REDIS_URL=__SECRET__

CORS_ORIGINS=["https://mehndiverse.example","https://admin.mehndiverse.example"]

# Production Supabase project — its service-role key and JWT secret are
# the highest-value secrets in this system (see docs/security-review.md
# #secret-handling); rotation procedure is in docs/incident-response.md
# #leaked-secret.
SUPABASE_URL=__SECRET__
SUPABASE_ANON_KEY=__SECRET__
SUPABASE_SERVICE_ROLE_KEY=__SECRET__
SUPABASE_JWT_SECRET=__SECRET__
SUPABASE_JWT_AUDIENCE=authenticated

# Razorpay *live-mode* keys (rzp_live_...) — real money moves through
# these; see docs/payments.md for the reconciliation/refund procedures
# that depend on them being correct.
RAZORPAY_KEY_ID=__SECRET__
RAZORPAY_KEY_SECRET=__SECRET__
RAZORPAY_WEBHOOK_SECRET=__SECRET__

AI_PROVIDER=local
AI_PROVIDER_API_KEY=__SECRET__

# Observability — see docs/observability.md.
METRICS_TOKEN=__SECRET__
SENTRY_DSN=__SECRET__
SENTRY_TRACES_SAMPLE_RATE=0.1
ALERT_WEBHOOK_URL=__SECRET__
