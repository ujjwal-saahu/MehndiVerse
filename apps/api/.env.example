# Copy to .env for local (non-Docker) development. Never commit the real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://mehndiverse:mehndiverse@localhost:5432/mehndiverse
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Supabase Authentication (see docs/authentication.md). Values below are
# non-functional placeholders — replace with a real project's values, never
# commit the result. SUPABASE_JWT_SECRET must match the project's JWT secret
# (Project Settings -> API -> JWT Settings) so access tokens verify locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-real-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key
SUPABASE_JWT_SECRET=replace-with-real-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Rate limit applied to /auth/register, /auth/login,
# /auth/password-reset/request, /auth/verify-email/resend.
AUTH_RATE_LIMIT=5/minute
