# Test environment — see docs/environments.md#test. Consumed by CI
# (.github/workflows/ci.yml sets these inline) and by a developer running
# `pytest` against a local throwaway database. Never used for anything
# with real user data.

ENVIRONMENT=test
LOG_LEVEL=WARNING
API_HOST=0.0.0.0
API_PORT=8000

# tests/conftest.py appends `_test` to the database name itself and creates
# it if missing — point this at the same server as local dev, not a
# separate one.
DATABASE_URL=postgresql+psycopg://mehndiverse:mehndiverse@localhost:5432/mehndiverse
REDIS_URL=redis://localhost:6379/1

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Never real credentials — every Supabase/Razorpay/AI-provider call in the
# test suite is mocked (respx), so these values are only ever checked for
# shape, never dialed out to.
SUPABASE_URL=https://test.supabase.co
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
SUPABASE_JWT_SECRET=test-jwt-secret-not-for-real-use
SUPABASE_JWT_AUDIENCE=authenticated

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=test-key-secret
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret
